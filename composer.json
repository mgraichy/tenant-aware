{
    "name": "mgraichy/tenant-aware",
    "description": "A package for multitenancy",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mgraichy\\TenantAware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Marlon Graichy",
            "email": "mgraichy@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Mgraichy\\TenantAware\\TenantAwareServiceProvider"
            ],
            "aliases": {
                "TenantAware": "Mgraichy\\TenantAware\\Facade"
            }
        }
    },
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "orchestra/testbench": "9.x-dev",
        "pestphp/pest": "3.x-dev",
        "pestphp/pest-plugin-laravel": "3.x-dev"
    }
}
